{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strictNullChecks": true,
		"strict": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"@interface/*": ["./interface/*"],
			"@utils/*": ["./utils/*"],
			"@assets/*": ["./assets/*"],
			"@screens/*": ["./screens/*"],
			"@constants/*": ["./constants/*"],
			"@store/*": ["./store/*"],
			"@styles/*": ["./styles/*"],
			"@components/*": ["./components/*"],
			"@hooks/*": ["./hooks/*"],
			"@base_pages/*": ["./base_pages/*"],
			"@contexts/*": ["./contexts/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx"]
}
