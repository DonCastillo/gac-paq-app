{
	"expo": {
		"name": "GAC-PAQ",
		"slug": "gacpaq-app",
		"version": "4.1.0",
		"scheme": "gacpaq",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "light",
		"splash": {
			"image": "./assets/splash-icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#ffffff"
		},
		"assetBundlePatterns": ["**/*"],
		"ios": {
			"supportsTablet": true,
			"requireFullScreen": true,
			"bundleIdentifier": "com.uleth.gacpaq",
			"infoPlist": {
				"UIBackgroundModes": ["fetch", "processing"],
				"NSMicrophoneUsageDescription": "This app requires microphone access for audio features.",
				"NSBackgroundFetchUsageDescription": "This app fetches updated data in the background."
			},
			"config": {
				"usesNonExemptEncryption": false
			}
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"package": "com.uleth.gacpaq",
			"versionCode": 91
		},
		"extra": {
			"eas": {
				"projectId": "11d18dae-7a98-46a2-a619-8efdc31cc2a5"
			}
		},
		"plugins": [
			"expo-audio",
			"expo-router",
			[
				"expo-screen-orientation",
				{
					"initialOrientation": "PORTRAIT_UP"
				}
			],
			[
				"expo-build-properties",
				{
					"android": {
						"compileSdkVersion": 36,
						"targetSdkVersion": 36,
						"buildToolsVersion": "36.0.0",
						"minSdkVersion": 24
					}
				}
			],
			"expo-web-browser",
			"expo-background-task",
			"./plugins/remove-audio-boot-receiver.js",
			"./plugins/allow-restricted-resizability.js",
			"expo-asset"
		]
	}
}
